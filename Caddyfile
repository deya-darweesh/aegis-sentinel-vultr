# Caddyfile: Production Domain & Cloudflare Reverse Proxy for AegisSentinel
# Enforces domain routing, automatic TLS, and blocks direct IP vulnerability probes

# 1. Secure Custom Domain block (enabled when DOMAIN is configured)
{$DOMAIN:aegis-sentinel.local} {
    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        flush_interval -1
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    log {
        output stdout
        format console
    }
}

# 2. Port 80 / Cloudflare HTTP Proxy Entrypoint
:80 {
    # If direct raw IP is probed instead of the configured domain, reject with 403
    @raw_ip_probe {
        header_regexp Host ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(:[0-9]+)?$
    }
    respond @raw_ip_probe "Access Denied: Direct IP access prohibited. Traffic must route through Cloudflare / protected domain." 403

    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        flush_interval -1
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }

    log {
        output stdout
        format console
    }
}
