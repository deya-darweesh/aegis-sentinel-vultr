# Vultr Serverless Inference Configuration
INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_BASE_URL=https://api.vultrinference.com/v1
VULTR_MODEL=kimi-k2-instruct
VULTR_CODE_MODEL=deepseek-v4.1-flash-1017

# Cost & Credit Preservation ($200 Budget Protection)
# Set to true for $0.00 local testing and mock execution
MOCK_MODE=true

# Sandbox Isolation Engine
SANDBOX_IMAGE=python:3.11-slim
PREFER_GVISOR=true
WORKSPACE_DIR=./data/workspaces

# Audit Telemetry & Cryptographic Verification
LOG_DIR=./data/audit
KEY_PATH=./data/secrets/ed25519.key

# Host & Server Configuration
HOST=0.0.0.0
PORT=8000
